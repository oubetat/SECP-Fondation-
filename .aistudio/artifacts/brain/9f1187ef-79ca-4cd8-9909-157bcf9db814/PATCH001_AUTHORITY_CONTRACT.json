      "maxUses": "Optional single-use or limited-use execution count",
      "usedCount": "Counter tracking capability consumption"
    },
    "validationBoundary": {
      "location": "SimulationSealingAuthorization.validateCapability",
      "checks": [
        "Capability object is non-null and is a valid object",
